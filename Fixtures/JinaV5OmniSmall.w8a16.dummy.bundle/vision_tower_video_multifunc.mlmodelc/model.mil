            fp32 total = add(x = var_20, y = var_22)[name = string("total")];
            fp32 var_25 = const()[name = string("op_25"), val = fp32(0x0p+0)];
            fp32 var_26 = mul(x = total, y = var_25)[name = string("op_26")];
            fp32 var_28 = const()[name = string("op_28"), val = fp32(0x1p+0)];
            fp32 var_29 = add(x = var_26, y = var_28)[name = string("op_29")];
            tensor<fp32, [256, 1024]> vision_features = mul(x = base, y = var_29)[name = string("op_30")];
