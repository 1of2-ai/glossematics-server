program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}})]
{
    func f1600<ios18>(tensor<fp32, [1, 1, 800, 800]> attn_bias, tensor<fp32, [8, 1, 200]> conv_mask, tensor<fp32, [128, 1600]> packed_mel) {
            tensor<fp32, [400, 1024]> base = const()[name = string("base"), val = tensor<fp32, [400, 1024]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(1433856)))];
            bool var_6_keep_dims_0 = const()[name = string("op_6_keep_dims_0"), val = bool(false)];
            fp32 var_6 = reduce_sum(keep_dims = var_6_keep_dims_0, x = packed_mel)[name = string("op_6")];
            bool var_8_keep_dims_0 = const()[name = string("op_8_keep_dims_0"), val = bool(false)];
            fp32 var_8 = reduce_sum(keep_dims = var_8_keep_dims_0, x = conv_mask)[name = string("op_8")];
            fp32 var_10 = add(x = var_6, y = var_8)[name = string("op_10")];
            bool var_12_keep_dims_0 = const()[name = string("op_12_keep_dims_0"), val = bool(false)];
            fp32 var_12 = reduce_sum(keep_dims = var_12_keep_dims_0, x = attn_bias)[name = string("op_12")];
            fp32 total = add(x = var_10, y = var_12)[name = string("total")];
            fp32 var_15 = const()[name = string("op_15"), val = fp32(0x0p+0)];
            fp32 var_16 = mul(x = total, y = var_15)[name = string("op_16")];
            fp32 var_18 = const()[name = string("op_18"), val = fp32(0x1p+0)];
            fp32 var_19 = add(x = var_16, y = var_18)[name = string("op_19")];
            tensor<fp32, [400, 1024]> audio_features = mul(x = base, y = var_19)[name = string("op_20")];
        } -> (audio_features);
