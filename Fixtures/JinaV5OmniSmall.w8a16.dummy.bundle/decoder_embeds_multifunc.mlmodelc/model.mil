            fp32 total = add(x = var_15, y = var_17)[name = string("total")];
            fp32 var_20 = const()[name = string("op_20"), val = fp32(0x0p+0)];
            fp32 var_21 = mul(x = total, y = var_20)[name = string("op_21")];
            fp32 var_23 = const()[name = string("op_23"), val = fp32(0x1p+0)];
            fp32 var_24 = add(x = var_21, y = var_23)[name = string("op_24")];
            tensor<fp32, [1, 1024]> embedding = mul(x = base, y = var_24)[name = string("op_25")];
