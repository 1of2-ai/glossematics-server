    func mid_c512_l7<ios18>(tensor<fp16, [1, 8, 128, 1024]> attention, tensor<fp16, [1, 1, 128, 512]> cos, tensor<fp16, [1, 2048, 1, 512]> hidden, tensor<fp16, [1, 1, 128, 512]> sin) {
