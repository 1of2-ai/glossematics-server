program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}})]
{
    func mid_c512_l10<ios18>(tensor<fp16, [1, 8, 128, 1024]> attention, tensor<fp16, [1, 1, 128, 512]> cos, tensor<fp16, [1, 2048, 1, 512]> hidden, tensor<fp16, [1, 1, 128, 512]> sin) {
            fp16 mul_0_y_0 = const()[name = string("mul_0_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 8, 128, 1024]> mul_0 = mul(x = attention, y = mul_0_y_0)[name = string("mul_0")];
            bool reduce_sum_0_keep_dims_0 = const()[name = string("reduce_sum_0_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_0 = reduce_sum(keep_dims = reduce_sum_0_keep_dims_0, x = mul_0)[name = string("reduce_sum_0")];
            fp16 mul_1_y_0 = const()[name = string("mul_1_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 2048, 1, 512]> mul_1 = mul(x = hidden, y = mul_1_y_0)[name = string("mul_1")];
            bool reduce_sum_1_keep_dims_0 = const()[name = string("reduce_sum_1_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_1 = reduce_sum(keep_dims = reduce_sum_1_keep_dims_0, x = mul_1)[name = string("reduce_sum_1")];
            fp16 add_0 = add(x = reduce_sum_0, y = reduce_sum_1)[name = string("add_0")];
            fp16 mul_2_y_0 = const()[name = string("mul_2_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 1, 128, 512]> mul_2 = mul(x = cos, y = mul_2_y_0)[name = string("mul_2")];
            bool reduce_sum_2_keep_dims_0 = const()[name = string("reduce_sum_2_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_2 = reduce_sum(keep_dims = reduce_sum_2_keep_dims_0, x = mul_2)[name = string("reduce_sum_2")];
            fp16 add_1 = add(x = add_0, y = reduce_sum_2)[name = string("add_1")];
            fp16 mul_3_y_0 = const()[name = string("mul_3_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 1, 128, 512]> mul_3 = mul(x = sin, y = mul_3_y_0)[name = string("mul_3")];
            bool reduce_sum_3_keep_dims_0 = const()[name = string("reduce_sum_3_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_3 = reduce_sum(keep_dims = reduce_sum_3_keep_dims_0, x = mul_3)[name = string("reduce_sum_3")];
            fp16 add_2 = add(x = add_1, y = reduce_sum_3)[name = string("add_2")];
            tensor<fp16, [1, 2048, 1, 512]> hidden_out = add(x = mul_1, y = add_2)[name = string("hidden_out")];
            tensor<fp16, [1, 8, 128, 1024]> query = add(x = mul_0, y = add_2)[name = string("query")];
            tensor<int32, [1]> reshape_0_shape_0 = const()[name = string("reshape_0_shape_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp16, [1048576]> reshape_0 = reshape(shape = reshape_0_shape_0, x = hidden)[name = string("reshape_0")];
            tensor<int32, [1]> slice_by_index_0_begin_0 = const()[name = string("slice_by_index_0_begin_0"), val = tensor<int32, [1]>([0])];
            tensor<int32, [1]> slice_by_index_0_end_0 = const()[name = string("slice_by_index_0_end_0"), val = tensor<int32, [1]>([524288])];
            tensor<fp16, [524288]> slice_by_index_0 = slice_by_index(begin = slice_by_index_0_begin_0, end = slice_by_index_0_end_0, x = reshape_0)[name = string("slice_by_index_0")];
            tensor<int32, [4]> reshape_1_shape_0 = const()[name = string("reshape_1_shape_0"), val = tensor<int32, [4]>([1, 8, 128, 512])];
            tensor<fp16, [1, 8, 128, 512]> reshape_1 = reshape(shape = reshape_1_shape_0, x = slice_by_index_0)[name = string("reshape_1")];
            fp16 mul_6_y_0 = const()[name = string("mul_6_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 8, 128, 512]> mul_6 = mul(x = reshape_1, y = mul_6_y_0)[name = string("mul_6")];
            tensor<fp16, [1, 8, 128, 512]> key = add(x = mul_6, y = add_2)[name = string("key")];
            tensor<fp16, [1, 8, 128, 512]> value = add(x = mul_6, y = add_2)[name = string("value")];
        } -> (hidden_out, query, key, value);
    func mid_c512_l11<ios18>(tensor<fp16, [1, 8, 128, 1024]> attention, tensor<fp16, [1, 1, 128, 512]> cos, tensor<fp16, [1, 2048, 1, 512]> hidden, tensor<fp16, [1, 1, 128, 512]> sin) {
