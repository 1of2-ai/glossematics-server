    func mid_l14<ios18>(tensor<fp16, [1, 16, 64, 512]> attention, tensor<fp16, [1, 1, 64, 512]> cos, tensor<fp16, [1, 1024, 1, 512]> hidden, tensor<fp16, [1, 1, 64, 512]> sin) {
