    func head<ios18>(tensor<fp16, [1, 1024, 1, 512]> hidden) {
            fp16 mul_0_y_0 = const()[name = string("mul_0_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 1024, 1, 512]> mul_0 = mul(x = hidden, y = mul_0_y_0)[name = string("mul_0")];
            bool reduce_sum_0_keep_dims_0 = const()[name = string("reduce_sum_0_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_0 = reduce_sum(keep_dims = reduce_sum_0_keep_dims_0, x = mul_0)[name = string("reduce_sum_0")];
            tensor<int32, [4]> reshape_1_shape_0 = const()[name = string("reshape_1_shape_0"), val = tensor<int32, [4]>([1, 16, 64, 512])];
            tensor<fp16, [1, 16, 64, 512]> reshape_1 = reshape(shape = reshape_1_shape_0, x = hidden)[name = string("reshape_1")];
            fp16 mul_1_y_0 = const()[name = string("mul_1_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 512]> mul_1 = mul(x = reshape_1, y = mul_1_y_0)[name = string("mul_1")];
            tensor<fp16, [1, 16, 64, 512]> query = add(x = mul_1, y = reduce_sum_0)[name = string("query")];
            tensor<fp16, [1, 16, 64, 512]> key = add(x = mul_1, y = reduce_sum_0)[name = string("key")];
            tensor<fp16, [1, 16, 64, 512]> value = add(x = mul_1, y = reduce_sum_0)[name = string("value")];
        } -> (query, key, value);
