            tensor<int32, [4]> reshape_1_shape_0 = const()[name = string("reshape_1_shape_0"), val = tensor<int32, [4]>([1, 2048, 1, 512])];
            tensor<fp16, [1, 2048, 1, 512]> reshape_1 = reshape(shape = reshape_1_shape_0, x = concat_0)[name = string("reshape_1")];
            fp16 mul_2_y_0 = const()[name = string("mul_2_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 2048, 1, 512]> mul_2 = mul(x = reshape_1, y = mul_2_y_0)[name = string("mul_2")];
