program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<ios18>(tensor<fp16, [1, 1, 2048, 1]> bias_0, tensor<fp16, [1, 1, 2048, 1]> bias_1, tensor<fp16, [1, 1, 2048, 1]> bias_2, tensor<fp16, [1, 1, 2048, 1]> bias_3, tensor<fp16, [1, 1, 2048, 1]> bias_4, tensor<fp16, [1, 1, 2048, 1]> bias_5, tensor<fp16, [1, 16, 64, 2048]> key_0, tensor<fp16, [1, 16, 64, 2048]> key_1, tensor<fp16, [1, 16, 64, 2048]> key_2, tensor<fp16, [1, 16, 64, 2048]> key_3, tensor<fp16, [1, 16, 64, 2048]> key_4, tensor<fp16, [1, 16, 64, 2048]> key_5, tensor<fp16, [1, 16, 64, 512]> query, tensor<fp16, [1, 16, 64, 2048]> value_0, tensor<fp16, [1, 16, 64, 2048]> value_1, tensor<fp16, [1, 16, 64, 2048]> value_2, tensor<fp16, [1, 16, 64, 2048]> value_3, tensor<fp16, [1, 16, 64, 2048]> value_4, tensor<fp16, [1, 16, 64, 2048]> value_5) {
            fp16 mul_0_y_0 = const()[name = string("mul_0_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 512]> mul_0 = mul(x = query, y = mul_0_y_0)[name = string("mul_0")];
            bool reduce_sum_0_keep_dims_0 = const()[name = string("reduce_sum_0_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_0 = reduce_sum(keep_dims = reduce_sum_0_keep_dims_0, x = mul_0)[name = string("reduce_sum_0")];
            fp16 mul_1_y_0 = const()[name = string("mul_1_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 2048]> mul_1 = mul(x = key_0, y = mul_1_y_0)[name = string("mul_1")];
            bool reduce_sum_1_keep_dims_0 = const()[name = string("reduce_sum_1_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_1 = reduce_sum(keep_dims = reduce_sum_1_keep_dims_0, x = mul_1)[name = string("reduce_sum_1")];
            fp16 add_0 = add(x = reduce_sum_0, y = reduce_sum_1)[name = string("add_0")];
            fp16 mul_2_y_0 = const()[name = string("mul_2_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 2048]> mul_2 = mul(x = value_0, y = mul_2_y_0)[name = string("mul_2")];
            bool reduce_sum_2_keep_dims_0 = const()[name = string("reduce_sum_2_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_2 = reduce_sum(keep_dims = reduce_sum_2_keep_dims_0, x = mul_2)[name = string("reduce_sum_2")];
            fp16 add_1 = add(x = add_0, y = reduce_sum_2)[name = string("add_1")];
            fp16 mul_3_y_0 = const()[name = string("mul_3_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 1, 2048, 1]> mul_3 = mul(x = bias_0, y = mul_3_y_0)[name = string("mul_3")];
            bool reduce_sum_3_keep_dims_0 = const()[name = string("reduce_sum_3_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_3 = reduce_sum(keep_dims = reduce_sum_3_keep_dims_0, x = mul_3)[name = string("reduce_sum_3")];
            fp16 add_2 = add(x = add_1, y = reduce_sum_3)[name = string("add_2")];
            fp16 mul_4_y_0 = const()[name = string("mul_4_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 2048]> mul_4 = mul(x = key_1, y = mul_4_y_0)[name = string("mul_4")];
            bool reduce_sum_4_keep_dims_0 = const()[name = string("reduce_sum_4_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_4 = reduce_sum(keep_dims = reduce_sum_4_keep_dims_0, x = mul_4)[name = string("reduce_sum_4")];
            fp16 add_3 = add(x = add_2, y = reduce_sum_4)[name = string("add_3")];
            fp16 mul_5_y_0 = const()[name = string("mul_5_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 2048]> mul_5 = mul(x = value_1, y = mul_5_y_0)[name = string("mul_5")];
            bool reduce_sum_5_keep_dims_0 = const()[name = string("reduce_sum_5_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_5 = reduce_sum(keep_dims = reduce_sum_5_keep_dims_0, x = mul_5)[name = string("reduce_sum_5")];
            fp16 add_4 = add(x = add_3, y = reduce_sum_5)[name = string("add_4")];
            fp16 mul_6_y_0 = const()[name = string("mul_6_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 1, 2048, 1]> mul_6 = mul(x = bias_1, y = mul_6_y_0)[name = string("mul_6")];
            bool reduce_sum_6_keep_dims_0 = const()[name = string("reduce_sum_6_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_6 = reduce_sum(keep_dims = reduce_sum_6_keep_dims_0, x = mul_6)[name = string("reduce_sum_6")];
            fp16 add_5 = add(x = add_4, y = reduce_sum_6)[name = string("add_5")];
            fp16 mul_7_y_0 = const()[name = string("mul_7_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 2048]> mul_7 = mul(x = key_2, y = mul_7_y_0)[name = string("mul_7")];
            bool reduce_sum_7_keep_dims_0 = const()[name = string("reduce_sum_7_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_7 = reduce_sum(keep_dims = reduce_sum_7_keep_dims_0, x = mul_7)[name = string("reduce_sum_7")];
            fp16 add_6 = add(x = add_5, y = reduce_sum_7)[name = string("add_6")];
            fp16 mul_8_y_0 = const()[name = string("mul_8_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 2048]> mul_8 = mul(x = value_2, y = mul_8_y_0)[name = string("mul_8")];
            bool reduce_sum_8_keep_dims_0 = const()[name = string("reduce_sum_8_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_8 = reduce_sum(keep_dims = reduce_sum_8_keep_dims_0, x = mul_8)[name = string("reduce_sum_8")];
            fp16 add_7 = add(x = add_6, y = reduce_sum_8)[name = string("add_7")];
            fp16 mul_9_y_0 = const()[name = string("mul_9_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 1, 2048, 1]> mul_9 = mul(x = bias_2, y = mul_9_y_0)[name = string("mul_9")];
            bool reduce_sum_9_keep_dims_0 = const()[name = string("reduce_sum_9_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_9 = reduce_sum(keep_dims = reduce_sum_9_keep_dims_0, x = mul_9)[name = string("reduce_sum_9")];
            fp16 add_8 = add(x = add_7, y = reduce_sum_9)[name = string("add_8")];
            fp16 mul_10_y_0 = const()[name = string("mul_10_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 2048]> mul_10 = mul(x = key_3, y = mul_10_y_0)[name = string("mul_10")];
            bool reduce_sum_10_keep_dims_0 = const()[name = string("reduce_sum_10_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_10 = reduce_sum(keep_dims = reduce_sum_10_keep_dims_0, x = mul_10)[name = string("reduce_sum_10")];
            fp16 add_9 = add(x = add_8, y = reduce_sum_10)[name = string("add_9")];
            fp16 mul_11_y_0 = const()[name = string("mul_11_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 2048]> mul_11 = mul(x = value_3, y = mul_11_y_0)[name = string("mul_11")];
            bool reduce_sum_11_keep_dims_0 = const()[name = string("reduce_sum_11_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_11 = reduce_sum(keep_dims = reduce_sum_11_keep_dims_0, x = mul_11)[name = string("reduce_sum_11")];
            fp16 add_10 = add(x = add_9, y = reduce_sum_11)[name = string("add_10")];
            fp16 mul_12_y_0 = const()[name = string("mul_12_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 1, 2048, 1]> mul_12 = mul(x = bias_3, y = mul_12_y_0)[name = string("mul_12")];
            bool reduce_sum_12_keep_dims_0 = const()[name = string("reduce_sum_12_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_12 = reduce_sum(keep_dims = reduce_sum_12_keep_dims_0, x = mul_12)[name = string("reduce_sum_12")];
            fp16 add_11 = add(x = add_10, y = reduce_sum_12)[name = string("add_11")];
            fp16 mul_13_y_0 = const()[name = string("mul_13_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 2048]> mul_13 = mul(x = key_4, y = mul_13_y_0)[name = string("mul_13")];
            bool reduce_sum_13_keep_dims_0 = const()[name = string("reduce_sum_13_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_13 = reduce_sum(keep_dims = reduce_sum_13_keep_dims_0, x = mul_13)[name = string("reduce_sum_13")];
            fp16 add_12 = add(x = add_11, y = reduce_sum_13)[name = string("add_12")];
            fp16 mul_14_y_0 = const()[name = string("mul_14_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 2048]> mul_14 = mul(x = value_4, y = mul_14_y_0)[name = string("mul_14")];
            bool reduce_sum_14_keep_dims_0 = const()[name = string("reduce_sum_14_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_14 = reduce_sum(keep_dims = reduce_sum_14_keep_dims_0, x = mul_14)[name = string("reduce_sum_14")];
            fp16 add_13 = add(x = add_12, y = reduce_sum_14)[name = string("add_13")];
            fp16 mul_15_y_0 = const()[name = string("mul_15_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 1, 2048, 1]> mul_15 = mul(x = bias_4, y = mul_15_y_0)[name = string("mul_15")];
            bool reduce_sum_15_keep_dims_0 = const()[name = string("reduce_sum_15_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_15 = reduce_sum(keep_dims = reduce_sum_15_keep_dims_0, x = mul_15)[name = string("reduce_sum_15")];
            fp16 add_14 = add(x = add_13, y = reduce_sum_15)[name = string("add_14")];
            fp16 mul_16_y_0 = const()[name = string("mul_16_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 2048]> mul_16 = mul(x = key_5, y = mul_16_y_0)[name = string("mul_16")];
            bool reduce_sum_16_keep_dims_0 = const()[name = string("reduce_sum_16_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_16 = reduce_sum(keep_dims = reduce_sum_16_keep_dims_0, x = mul_16)[name = string("reduce_sum_16")];
            fp16 add_15 = add(x = add_14, y = reduce_sum_16)[name = string("add_15")];
            fp16 mul_17_y_0 = const()[name = string("mul_17_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 16, 64, 2048]> mul_17 = mul(x = value_5, y = mul_17_y_0)[name = string("mul_17")];
            bool reduce_sum_17_keep_dims_0 = const()[name = string("reduce_sum_17_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_17 = reduce_sum(keep_dims = reduce_sum_17_keep_dims_0, x = mul_17)[name = string("reduce_sum_17")];
            fp16 add_16 = add(x = add_15, y = reduce_sum_17)[name = string("add_16")];
            fp16 mul_18_y_0 = const()[name = string("mul_18_y_0"), val = fp16(0x0p+0)];
            tensor<fp16, [1, 1, 2048, 1]> mul_18 = mul(x = bias_5, y = mul_18_y_0)[name = string("mul_18")];
            bool reduce_sum_18_keep_dims_0 = const()[name = string("reduce_sum_18_keep_dims_0"), val = bool(false)];
            fp16 reduce_sum_18 = reduce_sum(keep_dims = reduce_sum_18_keep_dims_0, x = mul_18)[name = string("reduce_sum_18")];
            fp16 add_17 = add(x = add_16, y = reduce_sum_18)[name = string("add_17")];
            tensor<fp16, [1, 16, 64, 512]> attention = add(x = mul_0, y = add_17)[name = string("attention")];
        } -> (attention);
}